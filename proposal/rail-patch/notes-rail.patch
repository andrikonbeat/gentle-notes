+test("notes rail section paints after TODO and hides through visibility", (t) => {
+	const f = fixture();
+	sidebarPart(f.tui, "todo", { render: (_width: number) => ["todo"], invalidate() {} });
+	sidebarPart(f.tui, "notes", { render: (_width: number) => ["Notas"], invalidate() {} });
+	t.after(installSidebar(f.tui, theme));
+	const lines = rail(f).render(50).map((line) => line.trim());
+	assert.match(lines.join("\n"), /Notas/);
+	assert.ok(lines.indexOf("todo") < lines.indexOf("Notas"), "notes paints after todo");
+	sidebarState(f.tui).visibility = { notes: false };
+	invalidateSidebar(f.tui);
+	assert.doesNotMatch(rail(f).render(50).join("\n"), /Notas/);
+	sidebarState(f.tui).visibility = { notes: true };
+	invalidateSidebar(f.tui);
+	assert.match(rail(f).render(50).join("\n"), /Notas/);
+});
